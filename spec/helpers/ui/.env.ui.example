# Copy to spec/helpers/ui/.env.ui (gitignored) and fill in the password.
#
# The UI tests log in as this user wherever a spec says `user: admin`.
# feral-authentication-service's scripts/init-test-data.sql seeds it, with
# the feral/admin role and the Feral Authentication application. It exists
# only in local databases, so a run that reached a live service would fail at
# login. Never put a real user here.
#
# Its password isn't in git. The service's test/acceptance/.env.acceptance
# logs in as the same user, with the same password.

UI_ADMIN_USERNAME=feral-test-admin
UI_ADMIN_PASSWORD=

# Optional. The defaults match ./start-feral-authentication.sh, and the
# application is the app's own VITE_APPLICATION_ID (scope `feral`).
# UI_APP_URL=http://localhost:5173/auth/
# UI_AUTH_SERVICE_URL=http://localhost:8003/api/feral-authentication-service/v0
# UI_APPLICATION_ID=e3304693-9a9f-48a0-ad03-f45bb3b73884
